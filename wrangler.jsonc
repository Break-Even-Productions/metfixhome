{
	"name": "metfixhome",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-12",
	"account_id": "84da09b9c67aa02ce3deb8edbdf5379c",
	"workers_dev": false,
	"preview_urls": true,
	"assets": {
		"directory": "./dist/public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/the-daily-fix",
			"/the-daily-fix/*",
			"/api/*",
			"/sitemap-daily-fix.xml",
			"/posts",
			"/posts/*",
			"/library",
			"/library/*"
		]
	},
	"kv_namespaces": [
		{
			"binding": "AUTH_SESSIONS",
			"id": "16d2ca6eae6c41adb8af8da5b71019ec",
			"preview_id": "6976f8cf9e934258bd253b1d65bb4ece",
			"remote": true
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	// Nine Rate Limiting bindings (S-RL / P8 + DP-CFG-1 account). namespace_id is an
	// account-unique integer you choose (not created in the dashboard). 27101–27106
	// and 27112–27114 are reserved for metfixhome on account 84da09b9… so they do
	// not collide with other Workers.
	"ratelimits": [
		{
			"name": "SIGNUP_LIMITER",
			"namespace_id": "27101",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "USERNAME_CHECK_LIMITER",
			"namespace_id": "27102",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "GOOGLE_AUTH_LIMITER",
			"namespace_id": "27103",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "COMMENT_WRITE_LIMITER",
			"namespace_id": "27104",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "COMMENT_LIKE_LIMITER",
			"namespace_id": "27105",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "COMMENT_LIKE_TOGGLE_LIMITER",
			"namespace_id": "27106",
			"simple": {
				"limit": 4,
				"period": 60
			}
		},
		{
			"name": "ACCOUNT_READ_LIMITER",
			"namespace_id": "27112",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "ACCOUNT_WRITE_LIMITER",
			"namespace_id": "27113",
			"simple": {
				"limit": 15,
				"period": 60
			}
		},
		{
			"name": "ACCOUNT_PORTAL_LIMITER",
			"namespace_id": "27114",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION",
				"class_name": "SessionDO"
			},
			{
				"name": "LOGIN_THROTTLE",
				"class_name": "LoginThrottleDO"
			},
			{
				"name": "OAUTH_STATE",
				"class_name": "OauthStateDO"
			}
		]
	},
	// Free plan (and accounts without an existing KV-backed DO namespace) require
	// SQLite-backed classes via `new_sqlite_classes`. KV storage API still works.
	// Rewriting the never-applied `v1-auth-dos` tag in place (deploy failed on
	// `new_classes` with Cloudflare API code 10097) — do not add a second tag.
	"migrations": [
		{
			"tag": "v1-auth-dos",
			"new_sqlite_classes": [
				"SessionDO",
				"LoginThrottleDO",
				"OauthStateDO"
			]
		}
	],
	// Non-secret: dedicated metfix.org WP OAuth client_id for BSI-C10 web-login (§0s.2).
	// Never from the browser; Worker never holds/sends METFIX_ORG_OAUTH_CLIENT_SECRET.
	// RECAPTCHA_SITE_KEY (public v3 site key) is intentionally omitted here — set it as a
	// plain Worker Variable in the Cloudflare dashboard (or wrangler vars) for prod/preview.
	// Do not put RECAPTCHA_SECRET in vars; use `wrangler secret put RECAPTCHA_SECRET`.
	"vars": {
		"BSI_OAUTH_CLIENT_ID": "BuaC0wOnq90L9H3d83gkCbmX736sWuG3dX9l7n1J",
		"GOOGLE_AUTH_ENABLED": "1",
		"GOOGLE_WEB_CLIENT_ID": "328949997919-e2j5nffdosrmma2ppjqpt3bak3rt425l.apps.googleusercontent.com",
    "RECAPTCHA_SITE_KEY": "6LfUFO0mAAAAAKxrVeYxZ9p3vMWNtvJzCKhqBs1R"
	},
	// Required for Worker Previews (`npx wrangler preview`, Wrangler ≥4.135).
	// Previews do not inherit top-level bindings — mirror vars / KV / DOs / ratelimits.
	"previews": {
		"vars": {
			"BSI_OAUTH_CLIENT_ID": "BuaC0wOnq90L9H3d83gkCbmX736sWuG3dX9l7n1J",
			"GOOGLE_AUTH_ENABLED": "1",
			"GOOGLE_WEB_CLIENT_ID": "328949997919-e2j5nffdosrmma2ppjqpt3bak3rt425l.apps.googleusercontent.com",
			"RECAPTCHA_SITE_KEY": "6LfUFO0mAAAAAKxrVeYxZ9p3vMWNtvJzCKhqBs1R",
			// AUTH-HOST allowlist for Worker Previews: previews.vars applies to every
			// preview (branch/PR), not only the staging branch. Exact hostnames only.
			// Never copy into top-level / production vars.
			"STAGING_AUTH_HOSTS": "staging-metfixhome.wispy-mode-982d.workers.dev",
			// Preview-only BSI origin (Ethan: purchase/data-change tests use staging BSI).
			// resolveBsiOrigin honors this only when it equals exactly this value AND the
			// request Host is in STAGING_AUTH_HOSTS. Never copy into top-level / production vars.
			"BSI_ORIGIN": "https://brokenstaging.wpengine.com"
		},
		"kv_namespaces": [
			{
				"binding": "AUTH_SESSIONS",
				"id": "6976f8cf9e934258bd253b1d65bb4ece"
			}
		],
		"durable_objects": {
			"bindings": [
				{
					"name": "SESSION",
					"class_name": "SessionDO"
				},
				{
					"name": "LOGIN_THROTTLE",
					"class_name": "LoginThrottleDO"
				},
				{
					"name": "OAUTH_STATE",
					"class_name": "OauthStateDO"
				}
			]
		},
		// Preview rate limits use a separate namespace_id band (27201–27206 +
		// 27212–27214) so Previews do not share counters with production.
		"ratelimits": [
			{
				"name": "SIGNUP_LIMITER",
				"namespace_id": "27201",
				"simple": {
					"limit": 5,
					"period": 60
				}
			},
			{
				"name": "USERNAME_CHECK_LIMITER",
				"namespace_id": "27202",
				"simple": {
					"limit": 20,
					"period": 60
				}
			},
			{
				"name": "GOOGLE_AUTH_LIMITER",
				"namespace_id": "27203",
				"simple": {
					"limit": 20,
					"period": 60
				}
			},
			{
				"name": "COMMENT_WRITE_LIMITER",
				"namespace_id": "27204",
				"simple": {
					"limit": 5,
					"period": 60
				}
			},
			{
				"name": "COMMENT_LIKE_LIMITER",
				"namespace_id": "27205",
				"simple": {
					"limit": 30,
					"period": 60
				}
			},
			{
				"name": "COMMENT_LIKE_TOGGLE_LIMITER",
				"namespace_id": "27206",
				"simple": {
					"limit": 4,
					"period": 60
				}
			},
			{
				"name": "ACCOUNT_READ_LIMITER",
				"namespace_id": "27212",
				"simple": {
					"limit": 60,
					"period": 60
				}
			},
			{
				"name": "ACCOUNT_WRITE_LIMITER",
				"namespace_id": "27213",
				"simple": {
					"limit": 15,
					"period": 60
				}
			},
			{
				"name": "ACCOUNT_PORTAL_LIMITER",
				"namespace_id": "27214",
				"simple": {
					"limit": 10,
					"period": 60
				}
			}
		]
	}
}
