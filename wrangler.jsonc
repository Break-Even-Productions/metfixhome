{
  "name": "metfixhome",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/the-daily-fix",
      "/the-daily-fix/*",
      "/api/*",
      "/sitemap-daily-fix.xml"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_SESSIONS",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "LOGIN_THROTTLE", "class_name": "LoginThrottleDO" },
      { "name": "OAUTH_STATE", "class_name": "OauthStateDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-auth-dos",
      "new_classes": ["SessionDO", "LoginThrottleDO", "OauthStateDO"]
    }
  ]
}
