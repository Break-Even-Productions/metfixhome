name: CI

on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  test-and-build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Install dependencies
        run: npm ci --legacy-peer-deps

      - name: Typecheck worker
        run: npm run check:worker

      - name: Unit and mount tests
        run: before=$(git status --porcelain --ignored --untracked-files=all); npm test; after=$(git status --porcelain --ignored --untracked-files=all); if [ "$before" != "$after" ]; then echo "V12(b) porcelain changed"; diff -u <(printf '%s\n' "$before") <(printf '%s\n' "$after") || true; exit 1; fi

      - name: Build static site
        run: npm run build:cf
        env:
          GITHUB_REPOSITORY: ${{ github.repository }}
          VITE_SANITY_PROJECT_ID: etg9lezr
          VITE_SANITY_DATASET: production

      - name: No Sanity token in dist
        run: |
          test -d dist/public
          if grep -rIlE --include='*.js' --include='*.html' --include='*.css' --include='*.map' '\bsk[A-Za-z0-9]{40,}\b' dist/public; then
            exit 1
          fi
          if grep -rIlE --include='*.js' --include='*.html' --include='*.css' --include='*.map' 'VITE_SANITY_API_READ_TOKEN' dist/public; then
            exit 1
          fi

      - name: B2 — no API key strings in client bundle
        run: |
          if grep -RInE 'DAILY_FIX_API_KEY|X-API-Key|test-secret-key' dist/public; then
            echo "B2 failed: secret strings found in dist/public" >&2
            exit 1
          fi
          echo "B2 ok: no key strings in dist/public"

      - name: Assert liquidglass stays out of App entry chunk
        run: npm run assert:liquidglass-chunk

      - name: Pool-workers HTMLRewriter tests (built dist)
        run: before=$(git status --porcelain --ignored --untracked-files=all); npm run test:workers; after=$(git status --porcelain --ignored --untracked-files=all); if [ "$before" != "$after" ]; then echo "V12(b) porcelain changed"; diff -u <(printf '%s\n' "$before") <(printf '%s\n' "$after") || true; exit 1; fi

      - name: Wrangler deploy dry-run
        run: npx wrangler deploy --dry-run
